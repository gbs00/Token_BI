{
  "name": "token-bi",
  "version": "1.2.2",
  "private": true,
  "description": "Token BI local sidecar dashboard app shell.",
  "scripts": {
    "desktop:assets": "node scripts/prepare_desktop.mjs",
    "desktop:test": "node --test tests/desktop_model.test.mjs",
    "desktop:preview": "./.venv/bin/python scripts/preview_menubar.py",
    "app:dev": "CARGO_TARGET_DIR=target.noindex tauri dev",
    "app:sidecar": "./scripts/build_sidecar.sh",
    "app:build": "npm run app:sidecar && CARGO_TARGET_DIR=target.noindex tauri build",
    "app:release:local": "./scripts/release_local.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "lucide-static": "^0.468.0"
  }
}
