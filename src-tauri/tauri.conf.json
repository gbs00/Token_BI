{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token BI",
  "version": "1.2.3",
  "identifier": "com.gbs00.tokenbi",
  "build": {
    "beforeBuildCommand": "npm run desktop:assets",
    "beforeDevCommand": "npm run desktop:assets",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/token-bi-control"],
    "resources": {
      "../dist/token-bi-control": "token-bi-control-runtime",
      "../dist/token-bi-backend": "token-bi-backend-runtime"
    },
    "icon": ["icons/icon.icns"],
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/gbs00/Token_BI/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRkNGQzk3MDYxNDJGNzgKUldSNEx4UUdsL3o4OEtDYzRITzVLL2xJTTVDbEM1b1NsRmwzUEdFa3pndUNXRHlzc0NlK0o0QksK"
    }
  }
}
